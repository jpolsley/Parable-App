  "css": ".pr-head { border-bottom: 0; position: relative; padding-bottom: 14pt; }\n.pr-head::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 7pt; background: radial-gradient(circle, #0B0B0D 1pt, transparent 1.25pt) 0 0 / 4pt 3.5pt; }\n.pr-head h1, .pr-family-head h1 { font-family: 'Inter Variable', sans-serif; font-weight: 700; letter-spacing: -0.03em; }\n.pr-sec-head { border-bottom: 0; position: relative; padding-bottom: 12pt; margin-bottom: 10pt; }\n.pr-sec-head::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 5pt; background: radial-gradient(circle, #0B0B0D 0.85pt, transparent 1.1pt) 0 0 / 3.5pt 2.5pt; }\n.pr-sec-head h2 { display: inline; background: #5AD7FF; padding: 0 6pt; font-family: 'Inter Variable', sans-serif; font-weight: 700; letter-spacing: -0.03em; }\n.pr-sec-head::before { content: ''; position: absolute; right: 8pt; top: 2pt; width: 46pt; height: 46pt; transform: rotate(-10deg); clip-path: polygon(50% 0%, 61% 30%, 90% 14%, 74% 44%, 100% 56%, 70% 64%, 82% 96%, 54% 76%, 34% 100%, 34% 70%, 4% 80%, 24% 54%, 0% 32%, 32% 30%, 22% 4%); background: radial-gradient(circle, #0B0B0D 0.75pt, transparent 1pt) 0 0 / 4pt 4pt, #F5F23A; }\n.pr-flow > .pr-sec:nth-child(5n+1) .pr-sec-head::before { background: radial-gradient(circle, #0B0B0D 0.75pt, transparent 1pt) 0 0 / 4pt 4pt, #F5F23A; clip-path: polygon(50% 0%, 61% 30%, 90% 14%, 74% 44%, 100% 56%, 70% 64%, 82% 96%, 54% 76%, 34% 100%, 34% 70%, 4% 80%, 24% 54%, 0% 32%, 32% 30%, 22% 4%); transform: rotate(-10deg); }\n.pr-flow > .pr-sec:nth-child(5n+2) .pr-sec-head::before { background: radial-gradient(circle, #0B0B0D 0.75pt, transparent 1pt) 0 0 / 4pt 4pt, #B8FF3D; clip-path: polygon(8% 14%, 46% 0%, 92% 8%, 100% 52%, 88% 94%, 40% 100%, 4% 82%, 0% 40%); transform: rotate(8deg); }\n.pr-flow > .pr-sec:nth-child(5n+3) .pr-sec-head::before { background: radial-gradient(circle, #0B0B0D 0.75pt, transparent 1pt) 0 0 / 4pt 4pt, #FF3DF0; clip-path: polygon(50% 0%, 61% 30%, 90% 14%, 74% 44%, 100% 56%, 70% 64%, 82% 96%, 54% 76%, 34% 100%, 34% 70%, 4% 80%, 24% 54%, 0% 32%, 32% 30%, 22% 4%); transform: rotate(-10deg); }\n.pr-flow > .pr-sec:nth-child(5n+4) .pr-sec-head::before { background: radial-gradient(circle, #0B0B0D 0.75pt, transparent 1pt) 0 0 / 4pt 4pt, #FF6A2B; clip-path: polygon(8% 14%, 46% 0%, 92% 8%, 100% 52%, 88% 94%, 40% 100%, 4% 82%, 0% 40%); transform: rotate(8deg); }\n.pr-flow > .pr-sec:nth-child(5n+5) .pr-sec-head::before { background: radial-gradient(circle, #0B0B0D 0.75pt, transparent 1pt) 0 0 / 4pt 4pt, #5AD7FF; clip-path: polygon(50% 0%, 61% 30%, 90% 14%, 74% 44%, 100% 56%, 70% 64%, 82% 96%, 54% 76%, 34% 100%, 34% 70%, 4% 80%, 24% 54%, 0% 32%, 32% 30%, 22% 4%); transform: rotate(-10deg); }\n.pr-p-head h3, .pr-weeks h3 { font-family: 'Inter Variable', sans-serif; font-weight: 700; letter-spacing: -0.015em; }\n.pr-p-num { color: #0B0B0D; background: #B8FF3D; padding: 3pt 4pt 1pt; font-size: 24pt; }\n.pr-eyebrow, .pr-p-kind, .pr-sg-kicker { color: #0A6CFF; }\n.pr-sg-kicker.warm { color: #E0480F; }\n.pr-tag { background: #5AD7FF; color: #0B0B0D; border-radius: 0; }\n.pr-sg-idea > div, .pr-family-strip { background: #0B0B0D; color: #FFFFFF; border-radius: 0; }\n.pr-sg-idea .pr-serif { color: #FFFFFF; }\n.pr-sg-idea .pr-label { color: #5AD7FF; }\n.pr-sg-questions span { color: #0B0B0D; background: #B8FF3D; font-size: 15pt; text-align: center; padding: 3pt 0 1pt; }\n.pr-sg-notes { background: #E8E8ED; border-radius: 0; }\n.pr-family-card, .pr-sg-close > div, .pr-roles > div { border: 1.5pt solid #0B0B0D; border-radius: 0; box-shadow: 4pt 4pt 0 #0B0B0D; }\n.pr-weeks .n { color: #0B0B0D; }\n.pr-family-strip { position: relative; }\n.pr-family-strip::after { content: ''; position: absolute; right: 10pt; top: -14pt; width: 54pt; height: 54pt; transform: rotate(12deg); clip-path: polygon(50% 0%, 61% 30%, 90% 14%, 74% 44%, 100% 56%, 70% 64%, 82% 96%, 54% 76%, 34% 100%, 34% 70%, 4% 80%, 24% 54%, 0% 32%, 32% 30%, 22% 4%); background: radial-gradient(circle, #0B0B0D 0.8pt, transparent 1.05pt) 0 0 / 4pt 4pt, #F5F23A; }\n.htdv .wk1, .htdv .wk2, .htdv .wk3, .htdv .wk4, .htdv .wk5 { display: none; }\n.htdv[class~=\"1\"] .wk1 { display: inline; }\n.htdv[class~=\"2\"] .wk2 { display: inline; }\n.htdv[class~=\"3\"] .wk3 { display: inline; }\n.htdv[class~=\"4\"] .wk4 { display: inline; }\n.htdv[class~=\"5\"] .wk5 { display: inline; }\n.htdv.Week .wk0 { display: none; }\n.htdv.Week .flair { display: inline; }\n.htdv .flair { display: none; }"
