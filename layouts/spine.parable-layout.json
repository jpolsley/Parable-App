  "cover": "<div style=\"position:relative;width:8.5in;height:11in;overflow:hidden;background:#1D1C19;color:#ECE6D8;font-family:'Oswald Variable',sans-serif;\">\n  \n  <svg viewBox=\"0 0 850 1100\" style=\"position:absolute;left:0;top:0;width:8.5in;height:11in\">\n    <defs>\n      <pattern id=\"spine-board\" width=\"5\" height=\"5\" patternUnits=\"userSpaceOnUse\">\n        <rect width=\"5\" height=\"5\" fill=\"#1D1C19\"/>\n        <line x1=\"0\" y1=\"5\" x2=\"5\" y2=\"0\" stroke=\"#24231F\" stroke-width=\"1\"/>\n      </pattern>\n      <linearGradient id=\"spine-shade\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n        <stop offset=\"0\" stop-color=\"#000\" stop-opacity=\"0.35\"/><stop offset=\"1\" stop-color=\"#000\" stop-opacity=\"0\"/>\n      </linearGradient>\n    </defs>\n    <rect width=\"850\" height=\"1100\" fill=\"url(#spine-board)\"/>\n    <rect x=\"0\" y=\"0\" width=\"30\" height=\"1100\" fill=\"#2F5BD3\"/>\n    <rect x=\"30\" y=\"0\" width=\"26\" height=\"1100\" fill=\"url(#spine-shade)\"/>\n  </svg>\n  <div data-fit style=\"position:absolute;right:0.5in;top:0.55in;width:2.7in;height:9.75in;font-size:200pt;display:flex;justify-content:flex-end;align-items:flex-end;\">\n    <h1 style=\"margin:0;writing-mode:vertical-rl;transform:rotate(180deg);font-size:1em;font-weight:700;line-height:0.84;letter-spacing:0.01em;text-transform:uppercase;color:#ECE6D8;\">{{title}}</h1>\n  </div>\n  <div style=\"position:absolute;left:0.95in;top:0.6in;font-family:'IBM Plex Mono',monospace;font-size:7.5pt;letter-spacing:0.06em;color:#C9C2AE;text-transform:uppercase;\">Leader guide / No. {{weeks}}</div>\n  <div style=\"position:absolute;left:0.95in;top:3.1in;width:4.1in;border:1.6pt solid #ECE6D8;border-radius:16pt;padding:16pt 18pt 14pt;\">\n    <p style=\"margin:0;font-size:10pt;letter-spacing:0.08em;text-transform:uppercase;line-height:1.35;\">{{eyebrow}}</p>\n    <div style=\"height:1.2pt;background:#ECE6D8;margin:12pt 0;opacity:0.9;\"></div>\n    <p data-fit style=\"margin:0;height:1.25in;font-size:19pt;font-weight:600;text-transform:uppercase;line-height:1.12;\">{{subtitle}}</p>\n    <div style=\"display:flex;align-items:center;gap:10pt;margin-top:12pt;\">\n      <svg viewBox=\"0 0 60 26\" style=\"width:0.62in;height:0.27in\">\n        <circle cx=\"13\" cy=\"13\" r=\"10.5\" fill=\"none\" stroke=\"#ECE6D8\" stroke-width=\"1.6\"/>\n        <path d=\"M8 13 a5 5 0 1 1 5 5\" fill=\"none\" stroke=\"#ECE6D8\" stroke-width=\"1.6\"/>\n        <circle cx=\"45\" cy=\"13\" r=\"10.5\" fill=\"none\" stroke=\"#ECE6D8\" stroke-width=\"1.6\"/>\n        <text x=\"45\" y=\"17\" text-anchor=\"middle\" font-family=\"Oswald Variable\" font-size=\"11\" fill=\"#ECE6D8\">{{weeks}}</text>\n      </svg>\n      <span style=\"font-size:9pt;letter-spacing:0.1em;text-transform:uppercase;\">{{weeks}} weeks</span>\n    </div>\n  </div>\n  <div style=\"position:absolute;left:0.95in;bottom:0.75in;width:4.2in;font-size:9.5pt;letter-spacing:0.12em;text-transform:uppercase;line-height:1.5;\">\n    <div style=\"color:#C9C2AE;\">{{dates}}</div>\n    <div style=\"font-weight:600;\">Parable · {{audience}}</div>\n  </div>\n</div>",
  "divider": "<div style=\"position:relative;width:8.5in;height:11in;overflow:hidden;background:#1D1C19;color:#ECE6D8;font-family:'Oswald Variable',sans-serif;\">\n  \n  <svg viewBox=\"0 0 850 1100\" style=\"position:absolute;left:0;top:0;width:8.5in;height:11in\">\n    <defs>\n      <pattern id=\"spine-board\" width=\"5\" height=\"5\" patternUnits=\"userSpaceOnUse\">\n        <rect width=\"5\" height=\"5\" fill=\"#1D1C19\"/>\n        <line x1=\"0\" y1=\"5\" x2=\"5\" y2=\"0\" stroke=\"#24231F\" stroke-width=\"1\"/>\n      </pattern>\n      <linearGradient id=\"spine-shade\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n        <stop offset=\"0\" stop-color=\"#000\" stop-opacity=\"0.35\"/><stop offset=\"1\" stop-color=\"#000\" stop-opacity=\"0\"/>\n      </linearGradient>\n    </defs>\n    <rect width=\"850\" height=\"1100\" fill=\"url(#spine-board)\"/>\n    <rect x=\"0\" y=\"0\" width=\"30\" height=\"1100\" fill=\"#2F5BD3\"/>\n    <rect x=\"30\" y=\"0\" width=\"26\" height=\"1100\" fill=\"url(#spine-shade)\"/>\n  </svg>\n  <div style=\"position:absolute;left:0.95in;top:0.6in;font-family:'IBM Plex Mono',monospace;font-size:7.5pt;letter-spacing:0.06em;color:#C9C2AE;text-transform:uppercase;\">{{kicker}}</div>\n  <div data-fit style=\"position:absolute;left:0.95in;bottom:3.35in;width:6.8in;height:2.4in;font-size:150pt;display:flex;align-items:flex-end;\">\n    <h1 style=\"margin:0;font-size:1em;font-weight:700;line-height:0.86;text-transform:uppercase;color:#ECE6D8;\">{{title}}</h1>\n  </div>\n  <div style=\"position:absolute;left:0.95in;bottom:0.85in;width:5.6in;border:1.6pt solid #ECE6D8;border-radius:16pt;padding:14pt 18pt;\">\n    <p data-fit style=\"margin:0;height:0.62in;font-size:22pt;font-weight:600;text-transform:uppercase;line-height:1.1;\">{{subtitle}}</p>\n    <div style=\"height:1.2pt;background:#ECE6D8;margin:10pt 0;opacity:0.9;\"></div>\n    <p data-fit style=\"margin:0;height:0.9in;font-family:'Inter Variable',sans-serif;font-size:12pt;line-height:1.4;color:#EC