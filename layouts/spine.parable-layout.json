  "css": ".pr-head { border-bottom: 4pt solid #1A1A18; }\n.pr-head h1, .pr-sec-head h2, .pr-family-head h1 { font-family: 'Oswald Variable', sans-serif; font-weight: 700; text-transform: uppercase; letter-spacing: 0.01em; }\n.pr-p-head h3, .pr-weeks h3 { font-family: 'Oswald Variable', sans-serif; font-weight: 600; text-transform: uppercase; letter-spacing: 0.01em; }\n.pr-sec-head { border-left: 9pt solid #2F5BD3; padding-left: 12pt; border-bottom: 4pt solid #1A1A18; }\n.pr-eyebrow, .pr-p-kind, .pr-sg-kicker { color: #2F5BD3; }\n.pr-say { border-left-color: #2F5BD3; }\n.pr-sg-idea > div, .pr-family-strip { background: #1D1C19; color: #ECE6D8; border-radius: 0; }\n.pr-sg-idea .pr-serif { color: #ECE6D8; }\n.pr-sg-idea .pr-label { color: #C9C2AE; }\n.pr-family-card, .pr-sg-close > div, .pr-roles > div { border: 1.5pt solid #1A1A18; border-radius: 12pt; }\n.pr-tag { background: #2F5BD3; border-radius: 3pt; }\n.pr-weeks { border-top: 4pt solid #1A1A18; }\n.pr-weeks .n { font-family: 'Oswald Variable', sans-serif; color: #2F5BD3; }"
